# Uruchomienia klienta i demona Docker.
-w /usr/bin/docker -p x -k docker
-w /usr/bin/dockerd -p x -k docker

# Zmiany konfiguracji Dockera i pliku daemon.json.
-w /etc/docker -p wa -k docker
-w /etc/docker/daemon.json -p wa -k docker

# Zmiany danych kontenerow, obrazow i volume'ow.
-w /var/lib/docker -p wa -k docker

# Dostep i zmiany Docker API przez Unix socket.
-w /var/run/docker.sock -p wa -k docker
-w /run/docker.sock -p wa -k docker

# Zmiany definicji uslugi Docker w systemd.
-w /usr/lib/systemd/system/docker.service -p wa -k docker
-w /etc/systemd/system/docker.service -p wa -k docker
